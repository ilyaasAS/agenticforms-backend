# Connexion BDD hors conteneur
DB_HOST=db
DB_PORT=3306
DB_NAME=agenticform
DB_USER=changeme_db_user
DB_PASSWORD=changeme_db_password

# JWT (obligatoire ; >= 32 caractères)
JWT_SECRET=changeme_jwt_secret_min_32_chars
JWT_EXPIRATION=86400000

# CORS (jamais *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OAuth2 Google / Azure (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# Compte admin initial
ADMIN_PASSWORD=changeme_admin_password